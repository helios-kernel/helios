package helios:system@0.1.0;

/// Spawn user program artifacts.
///
/// Two entry points are exposed:
///
/// * `spawn` returns a `child` resource that gives the parent direct
///   access to the child's `wasi:cli/stdin/stdout/stderr` as byte
///   streams. This is the low-level API used by the guest shell to
///   implement pipes, redirection, and background jobs.
///
/// * `exec` is a higher-level convenience that spawns a program, blocks
///   until it completes, and hands the parent the child's stdout and
///   stderr as buffered byte arrays. It has no stdin input. It is meant
///   for the RPC path where a remote inspector just wants one-shot
///   "run and give me the output" semantics and does not need streaming.
///
/// Both end up running exactly the same executable image on exactly the
/// same runtime. `exec` is just `spawn` + drain + wait, modelled at the
/// interface boundary so the common case does not need to express
/// streams in its wire format.
interface programs {
  use ipc.{endpoint};

  /// Stable identifier for a live program instance, used by the observer.
  type instance-id = u64;

  enum aot-hint {
    fast,
    balanced,
    performance,
  }

  enum filesystem-right {
    read,
    write,
    mutate-directory,
    execute,
  }

  record directory-grant {
    /// Directory path in the caller authority to derive from.
    source-path: string,
    /// Guest-visible preopen name in the child.
    guest-name: string,
    /// Rights granted to the child. These must be a subset of the
    /// caller's rights for `source-path`.
    rights: list<filesystem-right>,
  }

  enum network-right {
    tcp,
    udp,
    dns,
    privileged-bind,
    multicast,
    admin,
  }

  record network-grant {
    /// Network rights granted to the child. These must be a subset of
    /// the caller's network authority.
    rights: list<network-right>,
  }

  enum clock-right {
    set-wall-clock,
  }

  record clock-grant {
    /// Clock rights granted to the child. These must be a subset of
    /// the caller's clock authority.
    rights: list<clock-right>,
  }

  enum terminal-right {
    input,
    output,
    control,
  }

  record terminal-grant {
    /// Terminal rights granted to the child. These must be a subset of
    /// the caller's terminal authority.
    rights: list<terminal-right>,
  }

  enum process-right {
    spawn,
    exec,
    fork,
    join,
    signal,
  }

  record process-grant {
    /// Process-control rights granted to the child. These must be a
    /// subset of the caller's process authority.
    rights: list<process-right>,
  }

  enum link-right {
    source,
    target-directory,
    symlink-create,
    symlink-read,
  }

  record link-grant {
    /// Link rights granted to the child. These must be a subset of the
    /// caller's link authority and are separate from directory write.
    rights: list<link-right>,
  }

  enum mount-right {
    mount,
    unmount,
  }

  record mount-grant {
    /// Mount-table rights granted to the child. These must be a subset of
    /// the caller's mount authority; where the child may mount is still
    /// bounded by its directory grants.
    rights: list<mount-right>,
  }

  /// A machine-wide device class a program may claim. A program that
  /// holds none of them sees the same answers as a machine without that
  /// hardware: `available` lists nothing and `claim` reports the device
  /// unavailable.
  enum device-class {
    display,
    input,
    gpu,
    audio,
  }

  record device-grant {
    /// Device classes granted to the child. These must be a subset of the
    /// caller's device-class authority. Raw devices that discovery
    /// published are granted by name by the kernel when it starts their
    /// driver, never through this record.
    classes: list<device-class>,
  }

  /// Visibility or control scope for an instance-scoped capability.
  variant authority-scope {
    /// Only the holding instance itself.
    %own,
    /// The subtree rooted at the named instance, or at the newly spawned
    /// child instance itself when `none`.
    subtree(option<instance-id>),
    /// The entire machine, including kernel records and all instances.
    machine,
  }

  /// Orthogonal observation and diagnostic-control grants.
  variant diagnostics-grant {
    /// Read component and machine state (`helios:system/instances.snapshot`
    /// and `helios:system/inspect`) within the scope.
    inspect-read(authority-scope),
    /// Read tracing events (`helios:system/tracing.recent` and `subscribe`)
    /// within the scope.
    trace-read(authority-scope),
    /// Read profile samples (`helios:system/profiling.folded`, `metrics`,
    /// `instruction-samples`, and `raw-profile-*`) within the scope.
    profile-read(authority-scope),
    /// Mutate global diagnostic gates and profilers
    /// (`tracing.set-target-enabled`, `profiling.set-enabled`,
    /// `profiling.clear`, `profiling.start-instruction-sampling`).
    control,
  }

  /// A right over the machine itself rather than over individual instances.
  enum machine-right {
    /// Control machine-level execution and lifecycle (`helios:system/processors`
    /// online/offline transitions and `helios:system/snapshot.prepare`).
    control,
    /// Sign domain-separated challenges with this boot's Ed25519 machine
    /// identity key (`helios:system/machine-identity`).
    identity,
  }

  record machine-grant {
    /// Machine rights granted to the child. These must be a subset of
    /// the caller's machine authority.
    rights: list<machine-right>,
  }

  /// An IPC channel endpoint transferred to the child at launch.
  record ipc-grant {
    /// Name under which the child claims the endpoint via `helios:system/ipc.take`.
    name: string,
    /// Endpoint moved out of the caller into the child.
    endpoint: endpoint,
  }

  variant capability-grant {
    directory(directory-grant),
    network(network-grant),
    clock(clock-grant),
    terminal(terminal-grant),
    process(process-grant),
    link(link-grant),
    mount(mount-grant),
    device(device-grant),
    diagnostics(diagnostics-grant),
    /// Stop live instances (`helios:system/instances.kill`) within the scope.
    instance-control(authority-scope),
    machine(machine-grant),
    ipc(ipc-grant),
  }

  record spawn-request {
    /// Name the child is launched under. It becomes the child's
    /// `argv[0]` and names the instance for inspection and diagnostics.
    name: string,
    /// Argument vector passed to the launched component (argv[1..]).
    args: list<string>,
    /// Environment variables presented to the child via
    /// `wasi:cli/environment`.
    env: list<tuple<string, string>>,
    /// Path to an executable the caller is allowed to access.
    path: string,
    /// Explicit capabilities granted to the child. Empty means the
    /// child starts with no filesystem authority beyond its private
    /// stdio pipes.
    capability-grants: list<capability-grant>,
  }

  record exec-request {
    /// Name the child is launched under, which becomes its `argv[0]`.
    name: string,
    args: list<string>,
    env: list<tuple<string, string>>,
    path: string,
    /// Bytes piped into the child's stdin. Empty means "stdin closes
    /// immediately".
    stdin: list<u8>,
    hint: option<aot-hint>,
    /// Explicit capabilities granted to the child. Empty means the
    /// child starts with no filesystem authority beyond its private
    /// stdio pipes.
    capability-grants: list<capability-grant>,
  }

  record aot-request {
    source-path: string,
    destination-path: string,
    hint: aot-hint,
    /// Emit compiler-internal timing diagnostics for this request.
    profile: bool,
  }

  record aot-result {
    destination-path: string,
    /// How many worker threads the compiler plugin was told to compile
    /// with: the kernel-role processor count, which it reads as
    /// `RAYON_NUM_THREADS`.
    worker-threads: u32,
  }

  record exec-output {
    stdout: list<u8>,
    stderr: list<u8>,
  }

  record exec-result {
    instance-id: instance-id,
    exit-code: u32,
    output: exec-output,
    /// The launch's own duration in nanoseconds on the kernel's
    /// monotonic clock: from the `exec` call's arrival in the kernel
    /// to its result being in hand (the child exited and both output
    /// pipes drained), the interval the launch-phase timeline brackets
    /// from `rpc-arrival` to `reply`. Nothing outside the guest is
    /// inside it, so a caller across a transport reads the launch
    /// without the transport.
    launch-nanos: u64,
  }

  record signal-termination {
    signal: u8,
    core-dumped: bool,
  }

  variant child-termination {
    exited(u32),
    signaled(signal-termination),
    trapped,
    killed,
  }

  record exit-status {
    instance-id: instance-id,
    termination: child-termination,
  }

  enum spawn-error-kind {
    invalid-binary,
    missing-entry,
    unsupported-import,
    invalid-signature,
    invalid-path,
    permission-denied,
    invalid-hint,
    out-of-memory,
    unavailable,
    internal,
    /// The program file does not exist.
    not-found,
    /// Reading the program file failed with an I/O error.
    io,
  }

  record spawn-error {
    kind: spawn-error-kind,
    detail: string,
  }

  /// `exec` and `spawn` share the same error shape.
  type exec-error-kind = spawn-error-kind;
  type exec-error = spawn-error;

  /// Whether a container mount belongs exclusively to one container or may be
  /// shared with other containers and WASI programs. Must match the backing
  /// mount's sharing kind (`helios:system/mounts.mount-sharing`), which never
  /// changes while the mount exists.
  enum container-mount-sharing {
    /// Belongs exclusively to this container, which sees stored Unix ownership,
    /// modes, set-id bits and file capabilities within the mount's rights.
    private,
    /// Shared across containers and WASI programs; every node appears owned by
    /// the container's shared-mount identity, modes follow the mount's rights,
    /// and the mount is nosuid and nodev with file capabilities ignored.
    shared,
  }

  /// One filesystem mount inside a Linux container.
  record container-mount {
    /// Directory path in the caller's namespace and authority to mount.
    source-path: string,
    /// Normalized absolute mount point inside the container (`"/"` for the
    /// container's root, or a normalized path below `"/"`).
    target-path: string,
    /// Rights granted to the container on this mount. Must be a subset of the
    /// caller's rights for `source-path` and bounded by the backing mount.
    rights: list<filesystem-right>,
    /// Whether this mount is private to the container or shared.
    sharing: container-mount-sharing,
  }

  /// Owner and group IDs presented for every node on a shared mount inside
  /// a container.
  record container-identity {
    uid: u32,
    gid: u32,
  }

  /// Linux credentials a process starts with inside a container.
  record container-credentials {
    uid: u32,
    gid: u32,
    supplementary-groups: list<u32>,
  }

  /// Configuration of a new Linux container, bounded by the authority its
  /// `capability-grants` derive from the caller.
  record container-config {
    /// Container root mount (`target-path` must be `"/"`).
    root: container-mount,
    /// Additional mounts inside the container (`target-path` below `"/"`).
    mounts: list<container-mount>,
    /// Owner and group presented on every shared mount in this container.
    shared-owner: container-identity,
    /// Default credentials for processes started in this container.
    credentials: container-credentials,
    /// Initial UTS hostname (`uname().nodename`). Empty uses Linux's `"(none)"`.
    hostname: string,
    /// Initial UTS domain name (`uname().domainname`). Empty uses Linux's `"(none)"`.
    domainname: string,
    /// Non-filesystem capabilities granted to the container, derived as a
    /// subset of the caller's authority. Directory grants are refused here;
    /// filesystem authority comes solely from `root` and `mounts`.
    capability-grants: list<capability-grant>,
  }

  record container-spawn-request {
    /// Name the process is launched under (`argv[0]`).
    name: string,
    /// Argument vector (`argv[1..]`).
    args: list<string>,
    /// Environment variables.
    env: list<tuple<string, string>>,
    /// Path to a Linux executable inside the container's filesystem.
    path: string,
    /// Optional credentials override for this process; defaults to the
    /// container's configured credentials.
    credentials: option<container-credentials>,
  }

  record container-exec-request {
    /// Name the process is launched under (`argv[0]`).
    name: string,
    args: list<string>,
    env: list<tuple<string, string>>,
    /// Path to a Linux executable inside the container's filesystem.
    path: string,
    stdin: list<u8>,
    /// Optional credentials override for this process; defaults to the
    /// container's configured credentials.
    credentials: option<container-credentials>,
  }

  /// Handle to a running child program. Each stream accessor may be
  /// called at most once; subsequent calls return empty streams.
  /// Dropping the handle before `wait` completes terminates the child.
  resource child {
    /// Pipe bytes into the child's `wasi:cli/stdin`. Completing the
    /// returned future closes stdin and delivers EOF to the child.
    stdin: func(data: stream<u8>) -> future<result>;

    /// Read the child's `wasi:cli/stdout` as a byte stream.
    stdout: func() -> tuple<stream<u8>, future<result>>;

    /// Read the child's `wasi:cli/stderr` as a byte stream.
    stderr: func() -> tuple<stream<u8>, future<result>>;

    /// Await child completion and return its exit status.
    wait: async func() -> result<exit-status, spawn-error>;
  }

  /// Handle to a kernel Linux container. Processes started in this container
  /// share its root, mounts, PID namespace (starting at 1), hostname and
  /// domain name, and are bounded by the container's `ProcessAuthority`.
  resource container {
    /// Spawn a Linux program inside this container and return its child handle.
    spawn: async func(request: container-spawn-request) -> result<child, spawn-error>;

    /// Run a Linux program to completion inside this container, collecting its
    /// buffered stdout and stderr.
    exec: async func(request: container-exec-request) -> result<exec-result, exec-error>;
  }

  /// Create a new Linux container bounded by the caller's authority.
  create-container: async func(config: container-config) -> result<container, spawn-error>;

  /// Spawn a new program and return a handle for streaming its IO.
  spawn: async func(request: spawn-request) -> result<child, spawn-error>;

  /// Run a program to completion, returning its buffered stdout/stderr.
  /// Equivalent to `spawn` + drain output + `wait`.
  exec: async func(request: exec-request) -> result<exec-result, exec-error>;

  /// Ahead-of-time compile a raw wasm input into a signed `cwasm` output.
  aot: async func(request: aot-request) -> result<aot-result, exec-error>;
}
