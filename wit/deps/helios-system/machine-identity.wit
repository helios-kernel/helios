package helios:system@0.1.0;

/// Domain-separated Ed25519 challenge signing with this boot's machine
/// identity key.
///
/// The key is derived at bring-up from the measured-boot sealed seed (or the
/// per-boot ephemeral seed on platforms without measured boot) under the
/// HKDF-SHA256 domain `"helios.machine-identity.v1"`, distinct from the
/// compiler artifact signing key.
interface machine-identity {
  /// Why a machine-identity call was refused.
  variant sign-error {
    /// The caller does not hold `machine-right.identity`.
    denied,
    /// `domain` was empty, exceeded the 128-byte domain limit, or contained
    /// whitespace or non-graphic ASCII bytes.
    invalid-domain,
    /// `challenge` exceeded the maximum byte length carried by the variant.
    challenge-too-large(u32),
  }

  /// Returns this machine's 32-byte Ed25519 identity public key.
  public-key: func() -> result<list<u8>, sign-error>;

  /// Signs `challenge` under the non-empty graphic-ASCII `domain` label with
  /// this machine's Ed25519 identity key, returning the 64-byte signature over
  /// `"helios.machine-identity.v1\0" || u32_le(domain.len()) || domain || u32_le(challenge.len()) || challenge`.
  sign: func(domain: string, challenge: list<u8>) -> result<list<u8>, sign-error>;
}
