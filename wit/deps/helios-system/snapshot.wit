package helios:system@0.1.0;

/// Handing the machine's host share back to the VMM for a snapshot.
///
/// A VMM refuses to snapshot a guest whose 9p host share is attached.
/// `prepare` releases the share and returns a `snapshot-hold` resource that
/// keeps it released until the resource is dropped (the machine that keeps
/// running) or the machine generation advances (the copy restored from the
/// snapshot).
interface snapshot {
  /// Why `prepare` could not take a snapshot hold.
  enum snapshot-error {
    /// The caller does not hold `machine-right.control`.
    denied,
    /// Another `snapshot-hold` is already in force on this machine.
    busy,
  }

  /// Active hold keeping the machine's host share released for a VMM snapshot.
  ///
  /// Dropping this resource ends the hold and lets parked host-share
  /// operations re-attach and proceed.
  resource snapshot-hold {
    /// Whether the machine has a VM generation ID so a copy restored from the
    /// snapshot learns that it is a copy.
    has-generation-id: func() -> bool;
  }

  /// Why `hibernate` did not capture and persist a hibernate image.
  variant hibernate-error {
    /// The caller does not hold `machine-right.control`.
    denied,
    /// Another hibernate operation is already in progress.
    busy,
    /// This platform does not support hibernation.
    unsupported,
    /// No virtio-blk disk carrying the `helios-hibernate` serial is attached.
    no-hibernate-disk,
    /// The boot ran without a TPM-sealed authentication key.
    no-authentication-key,
    /// The hibernate disk is smaller than the required snapshot capacity.
    disk-too-small(string),
    /// Any other typed kernel hibernate failure.
    failed(string),
  }

  /// Waits for the host-share operations in flight to finish, returns the
  /// share to the host, and holds it released until the returned
  /// `snapshot-hold` drops. Operations issued while the hold is active wait
  /// for it to end; none fails.
  prepare: async func() -> result<snapshot-hold, snapshot-error>;

  /// Captures an atomic, compressed, authenticated hibernate image to the
  /// `helios-hibernate` disk and powers off the machine.
  ///
  /// On success the machine powers off before this call returns; it returns
  /// `ok` only when the machine resumes from that image on a later boot.
  hibernate: async func() -> result<_, hibernate-error>;
}
