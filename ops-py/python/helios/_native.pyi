from collections.abc import Awaitable
from typing import Any

class HeliosError(Exception): ...
class AttenuationDeniedError(HeliosError): ...
class TransportError(HeliosError): ...
class RpcError(HeliosError): ...
class TargetError(HeliosError): ...

class Target:
    def __init__(
        self,
        name: str,
        uri: str,
        *,
        labels: dict[str, str] | None = None,
        identity: str | None = None,
        default_scope: str | None = None,
    ) -> None: ...
    @staticmethod
    def from_uri(uri: str) -> Target: ...
    @property
    def name(self) -> str: ...
    @property
    def uri(self) -> str: ...
    @property
    def labels(self) -> dict[str, str]: ...
    @property
    def identity(self) -> str | None: ...
    @property
    def default_scope(self) -> str | None: ...
    @property
    def scheme(self) -> str: ...
    def matches_labels(self, filters: list[str]) -> bool: ...

class TargetStore:
    @staticmethod
    def load(path: str | None = None) -> TargetStore: ...
    @property
    def path(self) -> str: ...
    @property
    def default_target_name(self) -> str | None: ...
    def list(self) -> list[Target]: ...
    def resolve(self, spec: str | None = None) -> Target: ...
    def select_by_labels(self, filters: list[str]) -> list[Target]: ...
    def upsert(self, target: Target) -> None: ...
    def set_default(self, name: str) -> None: ...
    def remove(self, name: str) -> Target: ...
    def save(self) -> None: ...

class InspectEntry:
    @property
    def path(self) -> str: ...
    @property
    def value(self) -> Any: ...

class ComponentPublication:
    @property
    def instance_id(self) -> int: ...
    @property
    def instance_name(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def generation(self) -> int: ...
    @property
    def status(self) -> str: ...

class InspectSnapshot:
    @property
    def timestamp(self) -> int: ...
    @property
    def truncated(self) -> bool: ...
    @property
    def entries(self) -> list[InspectEntry]: ...
    @property
    def publications(self) -> list[ComponentPublication]: ...
    def to_dict(self) -> dict[str, Any]: ...
    def __len__(self) -> int: ...

class Instance:
    @property
    def id(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def started_at(self) -> int: ...
    @property
    def uptime_ns(self) -> int: ...
    @property
    def uptime_ms(self) -> float: ...
    @property
    def memory_bytes(self) -> int: ...
    @property
    def cpu_busy(self) -> int: ...

class TraceEvent:
    @property
    def timestamp(self) -> int: ...
    @property
    def level(self) -> str: ...
    @property
    def target(self) -> str: ...
    @property
    def fields(self) -> dict[str, Any]: ...

class ExecResult:
    @property
    def instance_id(self) -> int: ...
    @property
    def exit_code(self) -> int: ...
    @property
    def stdout(self) -> bytes: ...
    @property
    def stderr(self) -> bytes: ...
    @property
    def stdout_text(self) -> str: ...
    @property
    def stderr_text(self) -> str: ...

class Child:
    @property
    def instance_id(self) -> int | None: ...
    def read_stdout(self) -> Awaitable[bytes | None]: ...
    def read_stderr(self) -> Awaitable[bytes | None]: ...
    def signal(self, sig: str = "TERM") -> Awaitable[None]: ...
    def wait(self) -> Awaitable[ExecResult]: ...

class RemoteEntry:
    @property
    def path(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> str: ...

class RemoteStat:
    @property
    def path(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def size(self) -> int: ...

class BundleManifest:
    @property
    def target_name(self) -> str: ...
    @property
    def target_uri(self) -> str: ...
    @property
    def collected_at_rfc3339(self) -> str: ...
    @property
    def entries(self) -> list[str]: ...

class DiagnosticBundle:
    @property
    def manifest(self) -> BundleManifest: ...
    @property
    def entries(self) -> list[tuple[str, bytes]]: ...
    def write_tar_zst(self, path: str) -> Awaitable[str]: ...

class NodeOutcome:
    @property
    def target(self) -> Target: ...
    @property
    def elapsed_ms(self) -> float: ...
    @property
    def ok(self) -> bool: ...
    @property
    def value(self) -> Any: ...
    @property
    def error(self) -> str | None: ...
    def unwrap(self) -> Any: ...

class Session:
    @staticmethod
    def connect(
        target: Target | str | None = None,
        *,
        timeout_secs: float | None = None,
        scope: str | None = None,
        only: list[str] | None = None,
        identity: str | None = None,
        targets_path: str | None = None,
    ) -> Awaitable[Session]: ...
    @property
    def target(self) -> Target: ...
    @property
    def scope(self) -> str: ...
    @property
    def only(self) -> list[str]: ...
    @property
    def whoami(self) -> str: ...
    def __aenter__(self) -> Awaitable[Session]: ...
    def __aexit__(
        self,
        exc_type: Any = None,
        exc_val: Any = None,
        exc_tb: Any = None,
    ) -> Awaitable[bool]: ...
    def attenuated(
        self,
        *,
        scope: str | None = None,
        only: list[str] | None = None,
    ) -> Session: ...
    def inspect(
        self,
        prefixes: list[str] | None = None,
        *,
        limit: int = 0,
    ) -> Awaitable[InspectSnapshot]: ...
    def kernel_snapshot(self) -> Awaitable[dict[str, Any]]: ...
    def ps(self) -> Awaitable[list[Instance]]: ...
    def instances(self) -> Awaitable[list[Instance]]: ...
    def kill(self, target: int | str) -> Awaitable[int]: ...
    def trace_recent(
        self,
        *,
        limit: int = 64,
        min_level: str | None = "info",
        target_prefixes: list[str] | None = None,
    ) -> Awaitable[list[TraceEvent]]: ...
    def set_trace_target_enabled(
        self,
        target: str,
        enabled: bool = True,
    ) -> Awaitable[None]: ...
    def exec(
        self,
        path: str,
        args: list[str] | None = None,
    ) -> Awaitable[ExecResult]: ...
    def spawn(
        self,
        path: str,
        args: list[str] | None = None,
        *,
        env: dict[str, str] | None = None,
        stdin: bytes | None = None,
        grants: list[str] | None = None,
    ) -> Awaitable[Child]: ...
    def list_dir(self, path: str = "/") -> Awaitable[list[RemoteEntry]]: ...
    def stat(self, path: str) -> Awaitable[RemoteStat]: ...
    def read_file(self, path: str) -> Awaitable[bytes]: ...
    def write_file(
        self,
        path: str,
        data: bytes,
        *,
        append: bool = False,
    ) -> Awaitable[None]: ...
    def mkdir(self, path: str) -> Awaitable[None]: ...
    def remove(self, path: str) -> Awaitable[None]: ...
    def bundle(self, output_path: str | None = None) -> Awaitable[DiagnosticBundle]: ...

class Fleet:
    @staticmethod
    def from_targets(
        targets: list[Target | str],
        *,
        concurrency: int = 16,
        timeout_secs: float | None = None,
        scope: str | None = None,
        only: list[str] | None = None,
        identity: str | None = None,
        targets_path: str | None = None,
    ) -> Fleet: ...
    @staticmethod
    def from_labels(
        labels: list[str],
        *,
        concurrency: int = 16,
        timeout_secs: float | None = None,
        scope: str | None = None,
        only: list[str] | None = None,
        identity: str | None = None,
        targets_path: str | None = None,
    ) -> Fleet: ...
    @property
    def targets(self) -> list[Target]: ...
    @property
    def concurrency(self) -> int: ...
    def __aenter__(self) -> Awaitable[Fleet]: ...
    def __aexit__(
        self,
        exc_type: Any = None,
        exc_val: Any = None,
        exc_tb: Any = None,
    ) -> Awaitable[bool]: ...
    def inspect(
        self,
        prefixes: list[str] | None = None,
        *,
        limit: int = 0,
    ) -> Awaitable[list[NodeOutcome]]: ...
    def ps(self) -> Awaitable[list[NodeOutcome]]: ...
    def exec(
        self,
        path: str,
        args: list[str] | None = None,
    ) -> Awaitable[list[NodeOutcome]]: ...
    def collect_bundles(self) -> Awaitable[list[NodeOutcome]]: ...
