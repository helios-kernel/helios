{
  "check-host": {
    "command": "just check-host",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": [
      "kernel",
      "unix",
      "btrfs_src",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "test-embedded-debugger": {
    "guest-wasm": "debug",
    "guest-programs": ["init", "debugger"],
    "command": "just test-embedded-debugger",
    "warm": "just warm-test-embedded-debugger",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": [
      "kernel",
      "unix",
      "btrfs_src",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-fmt": {
    "command": "just fmt-check && just deny-check",
    "surfaces": [
      "aarch64",
      "riscv",
      "x86",
      "kernel",
      "unix",
      "btrfs_src",
      "venus",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-host": {
    "command": "just clippy-host",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": [
      "kernel",
      "unix",
      "btrfs_src",
      "venus",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-programs": {
    "command": "just clippy-programs",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": [
      "kernel",
      "unix",
      "btrfs_src",
      "venus",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-aarch64": {
    "rust-cache": true,
    "command": "just clippy-target aarch64-unknown-none helios-aarch64",
    "helios-cli": ["x64"],
    "surfaces": [
      "aarch64",
      "kernel",
      "unix",
      "btrfs_src"
    ]
  },
  "lint-riscv": {
    "rust-cache": true,
    "command": "just clippy-target riscv64gc-unknown-none-elf helios-riscv",
    "helios-cli": ["x64"],
    "surfaces": [
      "riscv",
      "kernel",
      "unix",
      "btrfs_src"
    ]
  },
  "lint-x86": {
    "rust-cache": true,
    "command": "just clippy-target x86_64-unknown-none helios-x86",
    "helios-cli": ["x64"],
    "surfaces": [
      "x86",
      "kernel",
      "unix",
      "btrfs_src"
    ]
  },
  "test-kernel": {
    "guest-wasm": "debug",
    "guest-programs": ["init", "debugger"],
    "command": "just test-kernel all",
    "warm": "just warm-test-kernel",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": [
      "kernel",
      "unix",
      "btrfs_src",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "test-libraries": {
    "command": "just test-libraries && just test-btrfs-mkfs",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": ["x86", "unix", "btrfs_src", "venus", "host_tools", "programs"]
  },
  "test-host-tools": {
    "guest-wasm": "debug",
    "guest-programs": ["compiler-plugin"],
    "command": "just test-host-tools",
    "warm": "just warm-test-host-tools",
    "helios-cli": ["x64"],
    "rust-cache": true,
    "surfaces": ["host_tools", "programs"]
  },
  "smoke-riscv64": {
    "heavy": true,
    "surfaces": ["riscv", "kernel", "unix", "btrfs_src", "host_tools", "programs"],
    "helios-cli": ["x64"],
    "guest-wasm": "release",
    "guest-programs": "all",
    "wasi-artifacts": true
  },
  "smoke-aarch64": {
    "heavy": true,
    "surfaces": ["aarch64", "kernel", "unix", "btrfs_src", "host_tools", "programs"],
    "helios-cli": ["arm64"],
    "guest-wasm": "release",
    "guest-programs": "all",
    "wasi-artifacts": true
  },
  "smoke-aarch64-cfi": {
    "heavy": true,
    "surfaces": ["aarch64", "kernel", "unix", "btrfs_src", "host_tools", "programs"],
    "guest-wasm": "debug",
    "guest-programs": ["init", "debugger"]
  },
  "smoke-x86-64": {
    "heavy": true,
    "surfaces": ["x86", "kernel", "unix", "btrfs_src", "host_tools", "programs"],
    "helios-cli": ["x64"],
    "guest-wasm": "release",
    "guest-programs": "all",
    "wasi-artifacts": true
  },
  "smoke-x86-64-cpu-lifecycle": {
    "heavy": true,
    "surfaces": ["x86", "kernel", "unix", "btrfs_src", "host_tools", "programs"],
    "helios-cli": ["x64"],
    "guest-wasm": "release",
    "guest-programs": ["init", "compiler-plugin", "debugger", "cpu", "http-client", "nu"],
    "wasi-artifacts": true
  },
  "smoke-x86-64-venus": {
    "heavy": true,
    "surfaces": ["gpu"],
    "exclusive": true,
    "helios-cli": ["x64"],
    "guest-wasm": "debug",
    "guest-programs": ["init", "debugger", "gpu-test", "compositor", "pride-flag", "nu"],
    "wasi-artifacts": true
  },
  "test-btrfs-upstream": {
    "surfaces": [
      "btrfs",
      "pin"
    ],
    "exclusive": true
  },
  "test-btrfs-fstests": {
    "heavy": true,
    "surfaces": [
      "btrfs"
    ],
    "exclusive": true
  },
  "linux-syscalls": {
    "surfaces": ["linux_abi"],
    "exclusive": true,
    "helios-cli": ["x64", "arm64"],
    "guest-wasm": "debug",
    "guest-programs": ["init", "debugger"]
  },
  "linux-syscalls-full": {
    "heavy": true,
    "surfaces": ["linux_abi"],
    "exclusive": true,
    "helios-cli": ["x64", "arm64"],
    "guest-wasm": "debug",
    "guest-programs": ["init", "debugger"]
  },
  "test-btrfs-fuzz": {
    "surfaces": [
      "btrfs",
      "pin"
    ],
    "exclusive": true
  }
}
