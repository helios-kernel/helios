{
  "check-host": {
    "command": "just check-host",
    "helios-cli": "debug",
    "rust-cache": true,
    "surfaces": [
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "test-embedded-debugger": {
    "guest-wasm": "debug",
    "command": "just test-embedded-debugger",
    "helios-cli": "debug",
    "rust-cache": true,
    "surfaces": [
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-fmt": {
    "command": "just fmt-check && just deny-check",
    "surfaces": [
      "aarch64",
      "riscv",
      "x86",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-host": {
    "command": "just clippy-host && just clippy-programs",
    "helios-cli": "debug",
    "rust-cache": true,
    "surfaces": [
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "lint-aarch64": {
    "rust-cache": true,
    "command": "just clippy-target aarch64-unknown-none helios-aarch64",
    "helios-cli": "debug",
    "surfaces": [
      "aarch64"
    ]
  },
  "lint-riscv": {
    "rust-cache": true,
    "command": "just clippy-target riscv64gc-unknown-none-elf helios-riscv",
    "helios-cli": "debug",
    "surfaces": [
      "riscv"
    ]
  },
  "lint-x86": {
    "rust-cache": true,
    "command": "just clippy-target x86_64-unknown-none helios-x86",
    "helios-cli": "debug",
    "surfaces": [
      "x86"
    ]
  },
  "test-kernel": {
    "guest-wasm": "debug",
    "command": "just test-kernel all",
    "helios-cli": "debug",
    "rust-cache": true,
    "surfaces": [
      "x86",
      "hosted",
      "host_tools",
      "programs"
    ]
  },
  "test-libraries": {
    "command": "just test-libraries && just test-btrfs-mkfs",
    "helios-cli": "debug",
    "rust-cache": true,
    "surfaces": ["x86", "host_tools", "programs", "btrfs"]
  },
  "test-host-tools": {
    "guest-wasm": "debug",
    "command": "just test-host-tools",
    "helios-cli": "debug",
    "rust-cache": true,
    "surfaces": ["hosted", "host_tools", "programs"]
  },
  "smoke-riscv64": {
    "heavy": true,
    "surfaces": ["riscv", "host_tools", "programs"],
    "guest-wasm": "release"
  },
  "smoke-aarch64": {
    "heavy": true,
    "surfaces": ["aarch64", "host_tools", "programs"],
    "guest-wasm": "release"
  },
  "smoke-aarch64-cfi": {
    "heavy": true,
    "surfaces": ["aarch64", "host_tools", "programs"],
    "guest-wasm": "debug"
  },
  "smoke-x86-64": {
    "heavy": true,
    "surfaces": ["x86", "host_tools", "programs"],
    "guest-wasm": "release"
  },
  "smoke-x86-64-cpu-lifecycle": {
    "heavy": true,
    "surfaces": ["x86", "host_tools", "programs"],
    "guest-wasm": "release"
  },
  "smoke-x86-64-venus": {
    "heavy": true,
    "surfaces": ["gpu"],
    "exclusive": true,
    "guest-wasm": "debug"
  },
  "test-btrfs-upstream": {
    "surfaces": [
      "btrfs",
      "pin"
    ],
    "exclusive": true
  },
  "test-btrfs-fstests": {
    "heavy": true,
    "surfaces": [
      "btrfs"
    ],
    "exclusive": true
  },
  "linux-syscalls": {
    "surfaces": ["linux_abi"],
    "exclusive": true,
    "guest-wasm": "release"
  },
  "linux-syscalls-full": {
    "heavy": true,
    "surfaces": ["linux_abi"],
    "exclusive": true,
    "guest-wasm": "release"
  },
  "test-btrfs-fuzz": {
    "surfaces": [
      "btrfs",
      "pin"
    ],
    "exclusive": true
  }
}
