# fstests' local.config for fuse-btrfs. run.sh copies it into the fstests tree
# and exports every HELIOS_FSTESTS_* variable it names.
export FSTYP=fuse
export FUSE_SUBTYP=.helios-btrfs
export TEST_DEV=$HELIOS_FSTESTS_TEST_DEV
export TEST_DIR=$HELIOS_FSTESTS_TEST_DIR
export SCRATCH_DEV=$HELIOS_FSTESTS_SCRATCH_DEV
export SCRATCH_MNT=$HELIOS_FSTESTS_SCRATCH_MNT
export RESULT_BASE=$HELIOS_FSTESTS_RESULTS
# FSTYP=fuse cleans SCRATCH_MNT by mounting it (_scratch_cleanup_files) rather
# than re-running mkfs, so check's pre-test _try_wipe_scratch_devs must not
# wipe SCRATCH_DEV's btrfs superblock.
export WIPEFS_PROG=
